# Example Environment Variables for TopCut Markets
#
# Copy this file and modify the addresses, then source it:
#   cp scripts/example.env my-markets.env
#   # Edit my-markets.env with your addresses
#   source my-markets.env
#   ./scripts/add-markets.sh

# Example market addresses (replace with your actual addresses)
BTC_TOPCUT_MARKET_6=0x1234567890123456789012345678901234567890
BTC_TOPCUT_MARKET_7=0xabcdefabcdefabcdefabcdefabcdefabcdefabcd
BTC_TOPCUT_MARKET_8=0x9876543210987654321098765432109876543210

# You can add as many markets as needed
# BTC_TOPCUT_MARKET_9=0x...
# BTC_TOPCUT_MARKET_10=0x...
# BTC_TOPCUT_MARKET_15=0x...  # Numbers don't need to be sequential
